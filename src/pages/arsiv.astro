---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
const articles=(await getCollection('articles')).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<Base title="Arşiv" description="Avrupa Gazetesi haber, analiz ve rehber arşivi"><h1>Arşiv</h1><p class="deck">{articles.length} doğrulanmış haber, analiz ve rehber.</p><div class="grid">{articles.map((article)=><ArticleCard article={article}/>)}</div></Base>
